# CubeNest Storage API — set this to the HTTPS backend URL for the frontend build
VITE_CUBENEST_API_URL=https://tablets-miscellaneous-bow-specialized.trycloudflare.com

# Legacy Supabase values are no longer used by the CubeNest login screen
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# CurseForge API (https://console.curseforge.com) — Bedrock catalog
# CurseForge API key is server-side only; configure CURSEFORGE_API_KEY in GitHub Actions Secrets
